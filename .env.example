# PostgreSQL
# Prefer DATABASE_URL for shared and production environments.
# Example: postgresql://samepage:password@127.0.0.1:5432/samepage_dev
DATABASE_URL=

# Unix-socket fallback (useful with Postgres.app on macOS).
PGHOST=/tmp
PGPORT=5432
PGUSER=stackzz
PGPASSWORD=
PGDATABASE=samepage_dev

# Sessions and OTP
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret

# Local review only. Set both to false in production.
OTP_DEV_MODE=true
DEMO_MODE=true

# Seed the 21 demo profiles into an empty database.
# Defaults to true outside production and false in production.
SEED_DEMO_DATA=true

# Keep disabled until the AI vendor and privacy review are approved.
AI_MATCHING_ENABLED=false
